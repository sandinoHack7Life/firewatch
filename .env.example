# Application
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
DATABASE_URL=postgresql+psycopg://your_database_user:your_database_password@localhost:5432/firewatch
FIRMS_MAP_KEY=your_nasa_firms_map_key_here
FIRMS_DAY_RANGE=2
SYNC_INTERVAL_SECONDS=300
OBSERVATION_RETENTION_DAYS=730
EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v3/events
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Optional SMTP delivery for watchlist alerts. Credentials are server-side only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=firewatch.mz.alertas@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=firewatch.mz.alertas@gmail.com
SMTP_USE_STARTTLS=true
