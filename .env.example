# Application
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/firewatch
FIRMS_MAP_KEY=
FIRMS_DAY_RANGE=2
SYNC_INTERVAL_SECONDS=300
OBSERVATION_RETENTION_DAYS=730
# Required to enable private field-visit APIs. Generate a random secret of at least 32 characters.
FIELD_DATA_ACCESS_KEY=
EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v3/events
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Optional SMTP delivery for watchlist alerts. Credentials are server-side only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
